#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#if defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)
#include <behaviors/hires_dial.dtsi>
#endif

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        combo_lang2 {
            bindings = <&kp LANG2>;
            key-positions = <28 27>;
        };

        combo_lang1 {
            bindings = <&kp LANG1>;
            key-positions = <33 34>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none             &none  &none  &none  &none                                  &none      &none  &none      &none    &none                 &none
&none  &kp Q             &kp W  &kp E  &kp R  &kp T                                  &kp Y      &kp U  &kp I      &kp O    &kp P                 &none
&none  &mt LCTRL A       &kp S  &kp D  &kp F  &kp G      &none          &none            &kp H      &kp J  &lt 1 K    &kp L    &mt RCTRL SEMICOLON   &none
&none  &mt LEFT_SHIFT Z  &kp X  &kp C  &kp V  &kp B      &none          &kp RET          &kp N      &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT FSLH  &none
&none  &kp LALT          &none  &none  &mkp MCLK  &kp SPACE  &lt 2 TAB  &lt 3 BACKSPACE  &kp ENTER  &none  &none      &none    &none                 &none
#if defined(TORABO_TSUKI_LP_KSCAN_4_DIRECTION_SWITCH)
&msc SCRL_UP &msc SCRL_DOWN &msc SCRL_LEFT &msc SCRL_RIGHT &mkp MCLK
#elif defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)
&mkp MCLK
#endif
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                    &trans    &trans      &trans     &trans     &trans         &trans
&trans  &trans  &trans  &trans     &trans     &trans                    &trans    &trans      &mkp MCLK  &trans     &trans         &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans    &trans    &mkp LCLK   &trans     &mkp RCLK  &kp PG_UP      &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans    &trans    &trans      &trans     &trans     &kp PAGE_DOWN  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &mkp MB4  &mkp MB5  &trans      &trans     &trans     &trans         &trans
#if defined(TORABO_TSUKI_LP_KSCAN_4_DIRECTION_SWITCH)
&msc SCRL_UP &msc SCRL_DOWN &msc SCRL_LEFT &msc SCRL_RIGHT &mkp MCLK
#elif defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)
&mkp MCLK
#endif
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans    &trans    &trans     &trans                  &trans     &trans  &trans  &trans  &trans        &trans
&trans  &none   &none     &kp UP    &none      &none                   &none      &kp N7  &kp N8  &kp N9  &kp LS(N0)    &trans
&trans  &none   &kp LEFT  &kp DOWN  &kp RIGHT  &none   &trans  &trans  &kp LBKT   &kp N4  &kp N5  &kp N6  &kp COLON     &trans
&trans  &none   &none     &none     &none      &none   &trans  &trans  &kp MINUS  &kp N1  &kp N2  &kp N3  &kp LS(INT1)  &trans
&trans  &trans  &trans    &trans    &trans     &trans  &trans  &trans  &trans     &kp N0  &trans  &trans  &trans        &trans
#if defined(TORABO_TSUKI_LP_KSCAN_4_DIRECTION_SWITCH)
&msc SCRL_UP &msc SCRL_DOWN &msc SCRL_LEFT &msc SCRL_RIGHT &mkp MCLK
#elif defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)
&kp C_MUTE
#endif
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans   &trans   &trans        &trans        &trans                      &trans            &trans     &trans         &trans     &trans      &trans
&trans  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5                      &kp HOME          &kp PG_UP  &kp PAGE_DOWN  &kp END    &kp ESCAPE  &trans
&trans  &kp F6   &kp F7   &kp F8        &kp F9        &kp F10     &trans  &trans  &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT  &kp TAB     &trans
&trans  &kp F11  &kp F12  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE  &kp PIPE    &trans
&trans  &trans   &trans   &trans        &kp DELETE    &kp TAB     &trans  &trans  &trans            &trans     &trans         &trans     &trans      &trans
#if defined(TORABO_TSUKI_LP_KSCAN_4_DIRECTION_SWITCH)
&msc SCRL_UP &msc SCRL_DOWN &msc SCRL_LEFT &msc SCRL_RIGHT &mkp MCLK
#elif defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)
&hires_dial_radial_controller_button
#endif
            >;
        };
    };
};

#if defined(TORABO_TSUKI_LP_INPUT_HIRES_DIAL)
&{/keymap/layer_0} {
    sensor-bindings = <&hires_dial_scroll 1 1>;
};

&{/keymap/layer_1} {
    sensor-bindings = <&hires_dial_scroll 10 1>;
};

&{/keymap/layer_2} {
    sensor-bindings = <&hires_dial_encoder C_VOL_UP C_VOL_DN>;
};

&{/keymap/layer_3} {
    /* Quarter-speed Radial Controller motion: output/input = 1/4. */
    sensor-bindings = <&hires_dial_radial_controller 4 1>;
};
#endif

&mt {
    require-prior-idle-ms = <120>;
};

&lt {
    require-prior-idle-ms = <120>;
};
